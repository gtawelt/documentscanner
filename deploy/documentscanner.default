# Konfiguration für documentscanner (/etc/default/documentscanner)

# --- Scan -------------------------------------------------------------------
# Color | Gray | Lineart
MODE=Color
RESOLUTION=300
SOURCE="ADF Duplex"
# Seitengröße in mm (A4)
PAGE_WIDTH=210
PAGE_HEIGHT=297

# Software-Bildkorrektur im SANE-fujitsu-Backend
# Auf Papierkante zuschneiden. Aus: schneidet bei dünnem/hellem Papier in den Inhalt
SWCROP=no
# Schieflage korrigieren (greift nur bei klarer Papierkante, siehe auch DESKEW)
SWDESKEW=yes
# Staubpunkte entfernen (Größe in Pixel, 0 = aus)
SWDESPECK=1

# --- Aufbereitung (scripts/process.py) ---------------------------------------
# Kopfstehende/gedrehte Seiten per Tesseract-Lageerkennung (nur OSD, kein OCR) drehen.
# Gedreht wird das ganze Dokument per Mehrheitsentscheid.
AUTOROTATE=1
# Mindest-Summe der Konfidenzen, damit das Dokument gedreht wird
ROTATE_MIN_CONF=2
# Ab dieser Konfidenz darf eine einzelne Seite abweichend gedreht werden (Querformat)
PAGE_ROTATE_CONF=6
# Duplex-Reihenfolge. Liegt der Stapel mit der Schrift nach oben im Einzug, liefert der
# Scanner je Blatt zuerst die Rückseite.
# auto: aus Seitenzahlen (Kopf-/Fußzeile) bzw. Blättern mit einer leeren Seite erkennen, sonst DUPLEX_DEFAULT
# front-first / back-first: fest vorgeben
DUPLEX_ORDER=auto
# back-first = Schrift nach oben eingelegt, front-first = Schrift nach unten
DUPLEX_DEFAULT=front-first
# Sprache für das Lesen der Seitenzahlen (tesseract-ocr-deu)
OCR_LANG=deu

# Schieflage anhand der Textzeilen korrigieren (bis zu DESKEW_MAX_ANGLE Grad)
DESKEW=1
DESKEW_MAX_ANGLE=45
# Ab dieser Schieflage wird im Log gewarnt, dass Ränder außerhalb des Scanbereichs lagen
SKEW_WARN=3

# Weißabgleich auf den Papierton, getöntes Papier und durchscheinende Rückseiten
# werden weiß, farbige Tinte bleibt erhalten.
CLEAN=1
# Anteil der Papierhelligkeit, ab dem ein Farbkanal weiß wird.
# Kleiner = mehr Durchscheinendes weg, aber blasse Schrift gefährdet.
WHITE_POINT=0.85
BLACK_POINT=60
# > 1 dunkelt blasse Schrift nach
INK_GAMMA=2.0
# 0..1: dunkelt farbige Tinte (Kugelschreiber, Stempel) zusätzlich ab
COLOR_BOOST=0.7
# Pixel, die danach in allen Kanälen mindestens so hell sind, werden reinweiß
WHITE_SNAP=0.8

# Leere Seiten weglassen: Prozent Tinten-Pixel (ohne Rand), unter denen eine Seite als leer gilt
SKIP_BLANK=1
BLANK_THRESHOLD=0.05
# Randbereich (Anteil je Seite), der bei der Leerseiten-Erkennung ignoriert wird
BLANK_MARGIN=0.06

# Rohdaten jedes Scans in RAW_DIR aufheben (zum Einstellen der Aufbereitung, ~25 MB/Seite)
KEEP_RAW=0
RAW_DIR=/var/lib/documentscanner/raw

# --- PDF ---------------------------------------------------------------------
# palette: PNG mit wenigen Farben – scharf und klein (~200–300 KB/Seite), ideal für Schriftstücke
# jpeg:    für Fotos/farbige Grafiken
# png:     verlustfrei, sehr groß
IMAGE_FORMAT=palette
PALETTE_COLORS=8
JPEG_QUALITY=75

# --- Verzeichnisse -----------------------------------------------------------
WORK_DIR=/var/lib/documentscanner/work
FAILED_DIR=/var/lib/documentscanner/failed
SPOOL_DIR=/var/spool/documentscanner/outbox
# CIFS-Mount von \\192.168.0.10\DATA\dokumente\scan
TARGET_DIR=/mnt/scan
